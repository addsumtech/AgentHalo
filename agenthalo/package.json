{
  "name": "agenthalo",
  "version": "1.0.5",
  "description": "A quiet desktop companion for your AI tasks.",
  "main": "src/main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win",
    "build:win:x64": "electron-builder --win nsis:x64",
    "build:win:arm64": "electron-builder --win nsis:arm64",
    "build:win:all": "electron-builder --win nsis:x64 nsis:arm64",
    "build:mac": "electron-builder --mac",
    "build:mac:x64": "electron-builder --mac dmg:x64 zip:x64",
    "build:mac:arm64": "electron-builder --mac dmg:arm64 zip:arm64",
    "build:linux": "electron-builder --linux",
    "build:linux:x64": "electron-builder --linux AppImage:x64 deb:x64",
    "build:all": "electron-builder --win --mac --linux",
    "verify:electron": "node scripts/verify-electron-install.js",
    "postinstall": "node scripts/verify-electron-install.js --context postinstall",
    "test": "node test/run-tests.js",
    "audit:assets": "node scripts/audit-repository-assets.js",
    "audit:native-package": "node scripts/audit-packaged-native.js",
    "audit:reachability": "node scripts/audit-runtime-reachability.js --check",
    "verify:updater-metadata": "node scripts/verify-updater-metadata.js",
    "verify:winget-arch": "node scripts/verify-winget-arch-contract.js",
    "verify:release": "node scripts/verify-release-version.js && node scripts/verify-release-contributors.js",
    "create-theme": "node scripts/create-theme.js",
    "export-agent-icons": "node scripts/export-agent-icons.js",
    "install:claude-hooks": "node hooks/install.js",
    "uninstall:claude-hooks": "node hooks/uninstall.js",
    "install:gemini-hooks": "node hooks/gemini-install.js",
    "install:antigravity-hooks": "node hooks/antigravity-install.js",
    "install:cursor-hooks": "node hooks/cursor-install.js",
    "install:kiro-hooks": "node hooks/kiro-install.js",
    "install:kimi-hooks": "node hooks/kimi-install.js",
    "install:qwen-hooks": "node hooks/qwen-code-install.js",
    "install:zcode-hooks": "node hooks/zcode-install.js",
    "uninstall:zcode-hooks": "node hooks/zcode-install.js --uninstall",
    "install:codewhale-hooks": "node hooks/codewhale-install.js",
    "uninstall:codewhale-hooks": "node hooks/codewhale-install.js --uninstall",
    "install:pi-extension": "node hooks/pi-install.js",
    "uninstall:pi-extension": "node hooks/pi-install.js --uninstall",
    "install:openclaw-plugin": "node hooks/openclaw-install.js",
    "uninstall:openclaw-plugin": "node hooks/openclaw-install.js --uninstall",
    "install:mimocode-plugin": "node hooks/mimocode-install.js",
    "uninstall:mimocode-plugin": "node hooks/mimocode-install.js --uninstall",
    "install:codex-hooks": "node hooks/codex-install.js",
    "uninstall:codex-hooks": "node hooks/codex-install.js --uninstall",
    "install:codex-debug-hooks": "node hooks/codex-debug-install.js",
    "uninstall:codex-debug-hooks": "node hooks/codex-debug-install.js --uninstall",
    "install:hermes-plugin": "node hooks/hermes-install.js",
    "uninstall:hermes-plugin": "node hooks/hermes-install.js --uninstall",
    "install:qoder-hooks": "node hooks/qoder-install.js",
    "uninstall:qoder-hooks": "node hooks/qoder-install.js --uninstall",
    "install:reasonix-hooks": "node hooks/reasonix-install.js",
    "uninstall:reasonix-hooks": "node hooks/reasonix-install.js --uninstall",
    "install:qoderwork-hooks": "node hooks/qoderwork-install.js",
    "uninstall:qoderwork-hooks": "node hooks/qoderwork-install.js --uninstall",
    "install:qwenwork-hooks": "node hooks/qwenwork-install.js",
    "uninstall:qwenwork-hooks": "node hooks/qwenwork-install.js --uninstall",
    "install:traecode-hooks": "node hooks/traecode-install.js",
    "uninstall:traecode-hooks": "node hooks/traecode-install.js --uninstall",
    "install:workbuddy-hooks": "node hooks/workbuddy-install.js",
    "uninstall:workbuddy-hooks": "node hooks/workbuddy-install.js --uninstall",
    "install:dsh": "node hooks/dsh-install.js",
    "uninstall:dsh": "node hooks/dsh-install.js --uninstall",
    "cleanup:integrations": "node hooks/cleanup-integrations.js --apply",
    "register-protocol:dev": "node launch.js --register-protocol"
  },
  "keywords": [
    "agenthalo",
    "desktop-pet",
    "electron",
    "claude-code"
  ],
  "author": "Addsum",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "build": {
    "appId": "com.agenthalo.desktop",
    "productName": "AgentHalo",
    "copyright": "© 2026 Addsum. Upstream: © 2026 Ruller_Lulu and contributors.",
    "afterPack": "scripts/after-pack-koffi.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "protocols": [
      {
        "name": "AgentHalo Import Protocol",
        "schemes": [
          "agenthalo",
          "clawd"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "entitlements": "build/entitlements.mac.plist",
      "identity": "-",
      "artifactName": "AgentHalo-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "AgentHalo switches to the browser tab or terminal associated with the task you click."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "AgentHalo-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "AgentHalo maintainers",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "AgentHalo-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "files": [
      "LICENSE",
      "NOTICE.md",
      "src/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "assets/icons/agents/**/*",
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "assets/sounds/**/*",
      "assets/dock-icon.png",
      "assets/tray-icon*.png",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/**/*",
      "!pwa/**/*",
      "!assets/svg/old/**/*",
      "!src/discord-presence-rpc.js",
      "!src/doctor-detectors/feishu-approval.js",
      "!src/feishu-approval-client.js",
      "!src/feishu-approval-migration-nudge.js",
      "!src/network/mobile-preview-lifecycle.js",
      "!src/network/mobile-preview-server.js",
      "!src/remote-ssh-decode.js",
      "!src/remote-ssh-deploy.js",
      "!src/remote-ssh-ipc.js",
      "!src/remote-ssh-local-config.js",
      "!src/remote-ssh-node.js",
      "!src/remote-ssh-runtime.js",
      "!src/remote-ssh-shell-detect.js",
      "!src/remote-ssh-transport-coordinator.js",
      "!src/remote-ssh-transport.js",
      "!src/session-automation-remote.js",
      "!src/settings-tab-discord-presence.js",
      "!src/settings-tab-mobile.js",
      "!src/settings-tab-remote-ssh.js",
      "!src/settings-tab-telegram-approval.js",
      "!src/slack-message-format.js",
      "!src/slack-notify-client.js",
      "!src/telegram-approval-log-meta.js",
      "!src/telegram-approval-runtime-status.js",
      "!src/telegram-companion.js",
      "!src/telegram-direct-send.js",
      "!src/telegram-fetch-transport.js",
      "!src/telegram-message-format.js",
      "!src/telegram-migration-controller.js",
      "!src/telegram-migration-nudge.js",
      "!src/telegram-native-client.js",
      "!src/telegram-native-runner.js",
      "!src/telegram-token-store.js",
      "!src/telegram-verification-failure.js",
      "!**/node_modules/@larksuiteoapi/node-sdk{,/**/*}",
      "!**/node_modules/electron-updater{,/**/*}",
      "!**/node_modules/markdown-it{,/**/*}",
      "!**/node_modules/ws{,/**/*}",
      "!**/node_modules/@protobufjs/aspromise{,/**/*}",
      "!**/node_modules/@protobufjs/base64{,/**/*}",
      "!**/node_modules/@protobufjs/codegen{,/**/*}",
      "!**/node_modules/@protobufjs/eventemitter{,/**/*}",
      "!**/node_modules/@protobufjs/fetch{,/**/*}",
      "!**/node_modules/@protobufjs/float{,/**/*}",
      "!**/node_modules/@protobufjs/path{,/**/*}",
      "!**/node_modules/@protobufjs/pool{,/**/*}",
      "!**/node_modules/@protobufjs/utf8{,/**/*}",
      "!**/node_modules/@types/node{,/**/*}",
      "!**/node_modules/agent-base{,/**/*}",
      "!**/node_modules/argparse{,/**/*}",
      "!**/node_modules/asynckit{,/**/*}",
      "!**/node_modules/axios{,/**/*}",
      "!**/node_modules/builder-util-runtime{,/**/*}",
      "!**/node_modules/call-bind-apply-helpers{,/**/*}",
      "!**/node_modules/call-bound{,/**/*}",
      "!**/node_modules/combined-stream{,/**/*}",
      "!**/node_modules/debug{,/**/*}",
      "!**/node_modules/delayed-stream{,/**/*}",
      "!**/node_modules/dunder-proto{,/**/*}",
      "!**/node_modules/es-define-property{,/**/*}",
      "!**/node_modules/es-errors{,/**/*}",
      "!**/node_modules/es-object-atoms{,/**/*}",
      "!**/node_modules/es-set-tostringtag{,/**/*}",
      "!**/node_modules/follow-redirects{,/**/*}",
      "!**/node_modules/form-data{,/**/*}",
      "!**/node_modules/fs-extra{,/**/*}",
      "!**/node_modules/function-bind{,/**/*}",
      "!**/node_modules/get-intrinsic{,/**/*}",
      "!**/node_modules/get-proto{,/**/*}",
      "!**/node_modules/gopd{,/**/*}",
      "!**/node_modules/graceful-fs{,/**/*}",
      "!**/node_modules/has-symbols{,/**/*}",
      "!**/node_modules/has-tostringtag{,/**/*}",
      "!**/node_modules/hasown{,/**/*}",
      "!**/node_modules/https-proxy-agent{,/**/*}",
      "!**/node_modules/js-yaml{,/**/*}",
      "!**/node_modules/jsonfile{,/**/*}",
      "!**/node_modules/lazy-val{,/**/*}",
      "!**/node_modules/linkify-it{,/**/*}",
      "!**/node_modules/lodash.escaperegexp{,/**/*}",
      "!**/node_modules/lodash.identity{,/**/*}",
      "!**/node_modules/lodash.isequal{,/**/*}",
      "!**/node_modules/lodash.merge{,/**/*}",
      "!**/node_modules/lodash.pickby{,/**/*}",
      "!**/node_modules/long{,/**/*}",
      "!**/node_modules/math-intrinsics{,/**/*}",
      "!**/node_modules/mdurl{,/**/*}",
      "!**/node_modules/mime-db{,/**/*}",
      "!**/node_modules/mime-types{,/**/*}",
      "!**/node_modules/ms{,/**/*}",
      "!**/node_modules/object-inspect{,/**/*}",
      "!**/node_modules/protobufjs{,/**/*}",
      "!**/node_modules/proxy-from-env{,/**/*}",
      "!**/node_modules/punycode.js{,/**/*}",
      "!**/node_modules/qs{,/**/*}",
      "!**/node_modules/sax{,/**/*}",
      "!**/node_modules/semver{,/**/*}",
      "!**/node_modules/side-channel{,/**/*}",
      "!**/node_modules/side-channel-list{,/**/*}",
      "!**/node_modules/side-channel-map{,/**/*}",
      "!**/node_modules/side-channel-weakmap{,/**/*}",
      "!**/node_modules/tiny-typed-emitter{,/**/*}",
      "!**/node_modules/uc.micro{,/**/*}",
      "!**/node_modules/undici-types{,/**/*}",
      "!**/node_modules/universalify{,/**/*}"
    ],
    "asarUnpack": [
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/**/*",
      "node_modules/jsonc-parser/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../agenthalo-web-bridge/extension",
        "to": "web-bridge-extension",
        "filter": [
          "manifest.json",
          "background.js",
          "content.js",
          "conversation-url.js",
          "icons/**/*"
        ]
      }
    ],
    "publish": []
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "dom-serializer": "^3.0.0",
    "electron-updater": "^6.8.3",
    "htmlparser2": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "2.16.3",
    "markdown-it": "15.0.0",
    "ws": "^8.21.0"
  }
}
